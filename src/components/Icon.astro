---
/**
 * Inline SVG icon set. All icons are decorative unless a `label` is provided,
 * in which case the SVG gets role="img" and an accessible title.
 */
interface Props {
  name:
    | 'facebook'
    | 'instagram'
    | 'tiktok'
    | 'play'
    | 'pause'
    | 'close'
    | 'arrow'
    | 'external'
    | 'phone'
    | 'mail'
    | 'pin'
    | 'menu'
    | 'ticket';
  label?: string;
  class?: string;
  size?: number;
}

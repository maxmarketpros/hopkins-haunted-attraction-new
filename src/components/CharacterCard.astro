---
import { Picture, getImage } from 'astro:assets';
import type { Character } from '../data/site';

interface Props {
  character: Character;
  sizes?: string;
  /** Include a lightbox trigger (requires <Lightbox /> on the page). */
  lightbox?: boolean;
  eager?: boolean;
}
const { character, sizes = '(min-width: 1024px) 22vw, (min-width: 600px) 45vw, 50vw', lightbox = false, eager = false } =
  Astro.props;

const full = lightbox
  ? await getImage({ src: character.image, width: Math.min(1200, character.image.width), format: 'webp' })
  : null;

const Tag = lightbox ? 'button' : 'div';
---

<figure class="cast-card hover-scale">
  <Tag
    class="cast-card__media media"
    {...(lightbox
      ? { type: 'button', 'data-lightbox': full!.src, 'data-alt': character.alt, 'data-caption': character.name }
      : {})}
  >
    <Picture
      src={character.image}
      alt={character.alt}
      formats={['avif', 'webp']}
      width={Math.min(900, character.image.width)}
      height={Math.round((Math.min(900, character.image.width) * 4) / 3)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    {lightbox && <span class="visually-hidden">View larger image of {character.name}</span>}
  </Tag>
  <figcaption class="cast-card__name">
    <span class="cast-card__rule" aria-hidden="true"></span>
    {character.name}
  </figcaption>
</figure>

<style>
  .cast-card {
    margin: 0;
    display: grid;
    gap: 12px;
  }

  .cast-card__media {
    aspect-ratio: 3 / 4;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: default;
    display: block;
    /* Matches the rounded corners baked into several of the source portraits. */
    border-radius: 4.4% / 3.3%;
  }

  button.cast-card__media {
    cursor: zoom-in;
  }

  .cast-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .cast-card__name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .cast-card__rule {
    width: 18px;
    height: 2px;
    background: var(--red-hi);
    flex: none;
  }
</style>

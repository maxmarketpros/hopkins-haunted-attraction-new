---
/**
 * Homepage hero using the original site's background video (same file as the
 * trailer). Autoplays muted, loops, plays inline. The still frame (from the
 * same footage) is shown until playback starts, for reduced-motion users, on
 * constrained connections, or when autoplay is blocked.
 */
import { Image } from 'astro:assets';
import still from '../assets/images/hero-still.jpg';
import Icon from './Icon.astro';
import { links, business, datesCompact, season } from '../data/site';
---

<section class="hero hero-video" data-state="loading" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Image
      src={still}
      alt=""
      class="hero__still"
      width={1440}
      height={1080}
      layout="full-width"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <video
      class="hero__video"
      muted
      playsinline
      loop
      preload="none"
      poster="/video/poster.jpg"
      data-src720="/video/hero-bg-720.mp4"
      data-src480="/video/hero-bg-480.mp4"
      tabindex="-1"
      disablepictureinpicture
    ></video>
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    <p class="label hero__label">
      <span>{business.address.city}, {business.address.region} · {business.address.county}</span>
      <span class="hero__label-season">{season.year} Season</span>
    </p>
    <h1 id="hero-title">
      Enter the Sinister <span class="accent">Woods.</span>
    </h1>
    <p class="lede hero__lede">
      An outdoor, walk-through haunted trail of live actors, sets and effects, set in the sinister woods of the 1800s
      at {business.venue} in {business.address.city}, {business.address.regionLong}.
    </p>
    <div class="hero__actions">
      <a id="primary-cta" class="btn btn--primary" href={links.tickets} target="_blank" rel="noopener">
        Buy Tickets <Icon name="external" size={18} />
      </a>
      <a class="btn btn--ghost" href="/experience/#trailer" data-trailer-open>
        <Icon name="play" size={20} /> Watch Trailer
      </a>
    </div>
    <p class="hero__dates">
      <span class="hero__dates-nights">{datesCompact}</span>
      <span class="hero__dates-hours">{season.hoursLine}</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(100svh, 960px);
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: clamp(56px, 8vw, 96px);
    overflow: hidden;
    background: var(--bg);
  }

  @media (max-width: 719px) {
    .hero {
      min-height: 0;
      padding-top: calc(var(--header-h) + 56px);
      padding-bottom: 40px;
    }
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg);
  }

  .hero__still,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42.6% 44.6%;
  }

  .hero__still {
    filter: saturate(0.9);
  }

  .hero__video {
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .hero-video[data-state='playing'] .hero__video {
    opacity: 1;
  }

  @media (max-width: 719px) {
    .hero__still,
    .hero__video {
      object-position: 48% 40%;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(8, 10, 9, 0.88) 0%, rgba(8, 10, 9, 0.62) 38%, rgba(8, 10, 9, 0.15) 70%, rgba(8, 10, 9, 0.05) 100%),
      linear-gradient(to top, var(--bg) 0%, rgba(8, 10, 9, 0.35) 30%, rgba(8, 10, 9, 0) 55%),
      linear-gradient(to bottom, rgba(8, 10, 9, 0.55), rgba(8, 10, 9, 0) 30%);
  }

  @media (max-width: 719px) {
    .hero__overlay {
      background:
        linear-gradient(to top, var(--bg) 0%, rgba(8, 10, 9, 0.7) 45%, rgba(8, 10, 9, 0.2) 80%),
        linear-gradient(to bottom, rgba(8, 10, 9, 0.6), rgba(8, 10, 9, 0) 35%);
    }
  }

  .hero__content {
    position: relative;
    max-width: var(--container);
  }

  .hero h1 {
    margin-bottom: 0.3em;
    max-width: 17ch;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.45);
  }

  .hero__lede {
    max-width: 52ch;
    color: var(--bone);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 24px;
  }

  @media (max-width: 479px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  .hero__label {
    flex-wrap: wrap;
    row-gap: 4px;
  }

  .hero__label-season {
    color: var(--red-text);
  }

  .hero__label-season::before {
    content: '·';
    color: var(--muted);
    margin-right: 12px;
  }

  @media (max-width: 719px) {
    .hero__label {
      display: block;
      letter-spacing: 0.12em;
      line-height: 1.5;
    }
    .hero__label::before {
      display: block;
      margin-bottom: 10px;
    }
    .hero__label span {
      display: block;
    }
    .hero__label-season::before {
      content: none;
    }
  }

  .hero__dates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
    margin: 0;
  }

  .hero__dates-hours::before {
    content: '';
    display: inline-block;
    width: 22px;
    height: 2px;
    background: var(--red-hi);
    margin: 0 14px;
    vertical-align: middle;
  }

  @media (max-width: 719px) {
    .hero__dates {
      display: grid;
      gap: 6px;
      padding-top: 14px;
      border-top: 1px solid var(--rule);
    }
    .hero__dates-nights {
      font-size: 15px;
    }
    .hero__dates-hours {
      color: var(--muted);
    }
    .hero__dates-hours::before {
      content: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      transition: none;
    }
  }
</style>

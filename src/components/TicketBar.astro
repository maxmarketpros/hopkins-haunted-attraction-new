---
import { links, lowestAdmission, money } from '../data/site';
import Icon from './Icon.astro';
---

<div class="ticket-bar" inert>
  <div class="ticket-bar__inner">
    <div class="ticket-bar__text">
      <strong>Admission from {money(lowestAdmission)}</strong>
      <span>plus fees · <a href="/tickets/">Tickets &amp; Dates</a></span>
    </div>
    <a class="btn btn--primary btn--sm" href={links.tickets} target="_blank" rel="noopener">
      Buy Tickets <Icon name="external" size={16} />
    </a>
  </div>
</div>

<style>
  .ticket-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    background: rgba(8, 10, 9, 0.96);
    border-top: 1px solid var(--rule-strong);
    padding: 10px var(--gutter) max(10px, env(safe-area-inset-bottom));
    transform: translateY(110%);
    transition: transform 260ms var(--ease);
    display: none;
  }

  @supports (backdrop-filter: blur(1px)) {
    .ticket-bar {
      background: rgba(8, 10, 9, 0.88);
      backdrop-filter: blur(12px);
    }
  }

  @media (max-width: 899px) {
    .ticket-bar {
      display: block;
    }
  }

  .ticket-bar.is-visible {
    transform: none;
  }

  :global(body.menu-open) .ticket-bar,
  :global(body.dialog-open) .ticket-bar,
  .ticket-bar.is-blocked {
    transform: translateY(110%);
  }

  .ticket-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .ticket-bar__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    font-size: 14px;
  }

  .ticket-bar__text strong {
    font-family: var(--font-display);
    font-size: 19px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ticket-bar__text span {
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket-bar {
      transition: none;
    }
  }
</style>

---
/**
 * Full-image lightbox. Any element with data-lightbox="<url>" (plus optional
 * data-alt / data-caption) opens it. Keyboard: Escape closes, arrows navigate.
 */
import Icon from './Icon.astro';
---

<dialog id="lightbox" class="lightbox" aria-label="Image viewer">
  <div class="dialog-inner">
    <button class="dialog-close" type="button">
      <Icon name="close" />
      <span class="visually-hidden">Close image</span>
    </button>
    <button class="lightbox__nav lightbox__prev" type="button" hidden>
      <Icon name="arrow" />
      <span class="visually-hidden">Previous image</span>
    </button>
    <figure class="lightbox__figure">
      <img alt="" decoding="async" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__next" type="button" hidden>
      <Icon name="arrow" />
      <span class="visually-hidden">Next image</span>
    </button>
  </div>
</dialog>

<style>
  .lightbox__figure {
    margin: 0;
    max-width: min(100%, 1400px);
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  .lightbox__figure img {
    max-height: calc(100vh - 120px);
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }

  .lightbox__caption {
    color: var(--muted);
    font-size: 14px;
    text-align: center;
    max-width: 70ch;
  }

  .lightbox__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: var(--surface);
    color: var(--bone);
    border: 1px solid var(--rule-strong);
    cursor: pointer;
    z-index: 2;
  }

  .lightbox__nav[hidden] {
    display: none;
  }

  .lightbox__prev {
    left: max(8px, env(safe-area-inset-left));
  }

  .lightbox__prev svg {
    transform: scaleX(-1);
  }

  .lightbox__next {
    right: max(8px, env(safe-area-inset-right));
  }

  .lightbox__nav svg {
    width: 22px;
    height: 22px;
  }
</style>

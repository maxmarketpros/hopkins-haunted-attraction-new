---
/**
 * Accessible <dialog> that plays the full trailer (same file as the hero).
 * Opened by any element with data-trailer-open. The video src is assigned
 * only when opened, so nothing downloads until requested.
 */
import Icon from './Icon.astro';
import { getImage } from 'astro:assets';
import still from '../assets/images/hero-still.jpg';
const poster = await getImage({ src: still, width: 960, height: 720, format: 'jpg' });
---

<dialog id="trailer-modal" class="trailer-modal" aria-labelledby="trailer-modal-title">
  <div class="dialog-inner">
    <button class="dialog-close" type="button">
      <Icon name="close" />
      <span class="visually-hidden">Close trailer</span>
    </button>
    <div class="trailer-modal__frame">
      <h2 id="trailer-modal-title" class="visually-hidden">Hopkins Haunted Attraction trailer</h2>
      <video
        controls
        playsinline
        preload="none"
        poster={poster.src}
        data-src="/video/trailer-720.mp4"
        width="960"
        height="720"
      >
        Your browser can’t play this video. <a href="/video/trailer-720.mp4">Download the trailer</a>.
      </video>
    </div>
  </div>
</dialog>

<style>
  .trailer-modal__frame {
    width: min(100%, calc((100vh - 96px) * 4 / 3), 1120px);
    aspect-ratio: 4 / 3;
    background: #000;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }

  .trailer-modal__frame video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
